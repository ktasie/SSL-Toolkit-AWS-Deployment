[Unit]
Description=SSL Toolkit Health Check
After=network.target

[Service]
Type=oneshot
User=ubuntu
# Put the real hostname in /etc/ssl-toolkit-health.env (not in Git).
EnvironmentFile=/etc/ssl-toolkit-health.env
ExecStart=/usr/local/bin/ssltoolkit-health-check.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
